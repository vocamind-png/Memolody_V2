{
  "version": 2,
  "buildCommand": "vite build",
  "framework": "vite",
  "rewrites": [
    { "source": "/vocalido/voicebanks/:path*", "destination": "https://storage.googleapis.com/memolody-vault/voicebanks/:path*" },
    { "source": "/vocalido/api/ai/extract-stems-midi", "destination": "https://u2txyroyplqko8-8888.proxy.runpod.net/vocalido/api/ai/extract-stems-midi" },
    { "source": "/vocalido/api/ai/extract-chords", "destination": "https://u2txyroyplqko8-8888.proxy.runpod.net/vocalido/api/ai/extract-chords" },
    { "source": "/vocalido/api/ai/transcribe-audio", "destination": "https://u2txyroyplqko8-8888.proxy.runpod.net/vocalido/api/ai/transcribe-audio" },
    { "source": "/vocalido/api/ai/tts", "destination": "https://u2txyroyplqko8-8888.proxy.runpod.net/vocalido/api/ai/tts" },
    { "source": "/vocalido/api/instrumento/render", "destination": "https://u2txyroyplqko8-8888.proxy.runpod.net/vocalido/api/instrumento/render" },
    { "source": "/vocalido/api/youtube/download", "destination": "https://u2txyroyplqko8-8888.proxy.runpod.net/vocalido/api/youtube/download" },
    { "source": "/vocalido/api/ai/separate-stems", "destination": "https://u2txyroyplqko8-8888.proxy.runpod.net/vocalido/api/ai/separate-stems" },
    { "source": "/vocalido/audio/:path*", "destination": "https://u2txyroyplqko8-8888.proxy.runpod.net/vocalido/audio/:path*" },
    { "source": "/vocalido/:path*", "destination": "https://u2txyroyplqko8-8888.proxy.runpod.net/:path*" },
    { "source": "/studio/preview-async", "destination": "https://u2txyroyplqko8-8888.proxy.runpod.net/studio/preview-async" },
    { "source": "/studio/job/:jobId", "destination": "https://u2txyroyplqko8-8888.proxy.runpod.net/studio/job/:jobId" },
    { "source": "/studio/:path*", "destination": "https://u2txyroyplqko8-8888.proxy.runpod.net/studio/:path*" },
    { "source": "/api/manifest", "destination": "https://storage.googleapis.com/memolody-vault/manifest.json" },
    { "source": "/api/runpod/:path*", "destination": "https://api.runpod.ai/v2/:path*" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600, stale-while-revalidate=86400" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ]
}
