{
  "version": 2,
  "buildCommand": "npm run build",
  "devCommand": "npm run dev:vite",
  "installCommand": "npm install",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/vocalido/:match*",
      "destination": "https://vocalido-server-YOUR_GCP_HASH.a.run.app/:match*"
    },
    {
      "source": "/studio/:match*",
      "destination": "https://vocalido-server-YOUR_GCP_HASH.a.run.app/studio/:match*"
    },
    {
      "source": "/api/:match*",
      "destination": "https://omr-server-YOUR_GCP_HASH.a.run.app/api/:match*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        },
        {
          "key": "Cross-Origin-Embedder-Policy",
          "value": "credentialless"
        }
      ]
    }
  ]
}
