{
  "version": 2,
  "buildCommand": "npm run build",
  "devCommand": "npm run dev:vite",
  "installCommand": "npm install",
  "framework": "vite",
  "rewrites": [
    { "source": "/vocalido/voicebanks/:path*", "destination": "https://storage.googleapis.com/memolody-vault/voicebanks/:path*" },
    { "source": "/vocalido/:path*", "destination": "https://u2txyroyplqko8-5001.proxy.runpod.net/:path*" },
    { "source": "/studio/:path*", "destination": "https://u2txyroyplqko8-5001.proxy.runpod.net/studio/:path*" },
    { "source": "/api/manifest", "destination": "https://storage.googleapis.com/memolody-vault/manifest.json" },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        },
        {
          "key": "Cross-Origin-Embedder-Policy",
          "value": "credentialless"
        }
      ]
    }
  ]
}
