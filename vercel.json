{
  "version": 2,
  "buildCommand": "vite build",
  "framework": "vite",
  "rewrites": [
    { "source": "/vocalido/voicebanks/:path*", "destination": "https://storage.googleapis.com/memolody-vault/voicebanks/:path*" },
    { "source": "/vocalido/:path*", "destination": "https://u2txyroyplqko8-8888.proxy.runpod.net/:path*" },
    { "source": "/studio/preview-async", "destination": "https://u2txyroyplqko8-8888.proxy.runpod.net/studio/preview-async" },
    { "source": "/studio/job/:jobId", "destination": "https://u2txyroyplqko8-8888.proxy.runpod.net/studio/job/:jobId" },
    { "source": "/studio/:path*", "destination": "https://u2txyroyplqko8-8888.proxy.runpod.net/studio/:path*" },
    { "source": "/api/manifest", "destination": "https://storage.googleapis.com/memolody-vault/manifest.json" },
    { "source": "/api/runpod/:path*", "destination": "https://api.runpod.ai/v2/:path*" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ]
}
